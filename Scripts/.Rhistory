clin_sinha
clin_sinha <- clin_sinha %>% mutate(protein_c = ifelse(is.na(protein_c) == TRUE, 0, protein_c))
all <- clin_sinha %>% mutate(protein_c = ifelse(is.na(protein_c) == TRUE, 0, protein_c))
# Offset IL8 and protein c values by 1 and log transform (as done in the model fitting)
all$il_8_trans <- log(all$cxcl8_il_8_a4 + 1)
all$protein_c_trans <- log(all$protein_c + 1)
# Function to apply three-variable logistic regression model
mod <- function(IL8, bic, protC) {
6.1241 + (1.4226*IL8) + (-0.2596*bic) + (-1.8330*protC)
}
# Apply function
all$out <- mod(all$il_8_trans, all$bicarbonate, all$protein_c_trans)
# Inverse logit function to retrieve probabilities
all$prob <- exp(all$out)/(1+exp(all$out))
# Assign classes based on 0.5 probability cutoff
all$class <- ifelse(all$prob < 0.5, 'Hypo', 'Hyper')
all$class
all$class %>% summary()
all$class %>% table()
